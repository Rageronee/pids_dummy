# ============================================================
# Eltran PIDS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# PostgreSQL Connection (REQUIRED)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/eltran_pids

# API Server Port (default: 3001)
# The master-app backend serves REST + Socket.IO on this port.
# selector-app and command-center-app connect to this port.
API_PORT=3001

# Vite Dev Server Ports (defaults match package.json scripts)
VITE_MASTER_PORT=5173
VITE_SELECTOR_PORT=5174
VITE_CC_PORT=5176
